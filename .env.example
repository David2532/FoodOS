NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only canonical Supabase URL for catalog import/sync jobs. It must never be exposed to client code.
SUPABASE_URL=https://your-project.supabase.co
# New projects should use the publishable key. The legacy anon key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional legacy fallback; omit when a publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only exact public app origin for state-changing authentication routes; no path/query/hash.
FOODOS_APP_ORIGIN=https://app.example.com
# Show Google OAuth only after the provider and exact callback URL are enabled in Supabase.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
# Show Apple OAuth only after the provider, exact callback URL and secret rotation are configured.
NEXT_PUBLIC_OAUTH_APPLE_ENABLED=false
# Optional production demo with fictitious data only. Local development enables it automatically.
NEXT_PUBLIC_DEMO_MODE_ENABLED=false
# Identify the application with a real monitored contact address. Do not use an invented identity.
OPEN_FOOD_FACTS_USER_AGENT=
# Optional override for a reviewed official JSONL(.gz) source; default is Open Food Facts' current full JSONL export.
PUBLIC_CATALOG_DUMP_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
# Required only for a controlled local JSONL replay; must be that source file's lower-case SHA-256.
# PUBLIC_CATALOG_LOCAL_SOURCE_SHA256=
# Server-only secret used by the scheduled recall-ingestion endpoint.
CRON_SECRET=generate-a-long-random-value
# Server-only Supabase key for the allowlisted recall ingestion job. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Monitored contact for the official recall feed requests.
RECALL_USER_AGENT=FoodOS/0.1 recall ingestion (contact@example.com)
