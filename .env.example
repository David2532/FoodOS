NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New projects should use the publishable key. The legacy anon key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional legacy fallback; omit when a publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Show Google OAuth only after the provider and exact callback URL are enabled in Supabase.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
# Show Apple OAuth only after the provider, exact callback URL and secret rotation are configured.
NEXT_PUBLIC_OAUTH_APPLE_ENABLED=false
# Optional production demo with fictitious data only. Local development enables it automatically.
NEXT_PUBLIC_DEMO_MODE_ENABLED=false
# Identify the application and provide a monitored contact address to Open Food Facts.
OPEN_FOOD_FACTS_USER_AGENT=FoodOS/0.1 (contact@example.com)
# Server-only secret used by the scheduled recall-ingestion endpoint.
CRON_SECRET=generate-a-long-random-value
# Server-only Supabase key for the allowlisted recall ingestion job. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Monitored contact for the official recall feed requests.
RECALL_USER_AGENT=FoodOS/0.1 recall ingestion (contact@example.com)
