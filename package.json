{
  "name": "foodos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:changed": "vitest related --run",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "catalog:import": "node scripts/import-public-catalog.mjs",
    "catalog:verify": "node scripts/verify-public-catalog.mjs",
    "agent:context": "node scripts/agent/agent-context.mjs",
    "agent:validate-company": "node scripts/agent/validate-company-config.mjs",
    "migration:new": "node scripts/agent/migration-new.mjs",
    "verify:changed": "node scripts/agent/verify-changed.mjs",
    "verify:full": "npm run verify",
    "verify": "npm run agent:validate-company && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "geist": "1.7.2",
    "lucide-react": "1.29.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
